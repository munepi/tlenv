#!/usr/bin/env bash
set -e

if [ "$1" = "--debug" ]; then
  export TLENV_DEBUG=1
  shift
fi

if [ -n "$TLENV_DEBUG" ]; then
  # https://web.archive.org/web/20221105082147/https://wiki-dev.bash-hackers.org/scripting/debuggingtips#making_xtrace_more_useful
  export PS4='+(${BASH_SOURCE}:${LINENO}): ${FUNCNAME[0]:+${FUNCNAME[0]}(): }'
  set -x
fi

abort() {
  { if [ "$#" -eq 0 ]; then cat -
    else echo "tlenv: $*"
    fi
  } >&2
  exit 1
}

if [ -z "${TLENV_ROOT}" ]; then
  TLENV_ROOT="${HOME}/.tlenv"
else
  TLENV_ROOT="${TLENV_ROOT%/}"
fi
export TLENV_ROOT

if [ -z "${TLENV_DIR}" ]; then
  TLENV_DIR="$PWD"
else
  [[ $TLENV_DIR == /* ]] || TLENV_DIR="$PWD/$TLENV_DIR"
  cd "$TLENV_DIR" 2>/dev/null || abort "cannot change working directory to \`$TLENV_DIR'"
  TLENV_DIR="$PWD"
  cd "$OLDPWD"
fi
export TLENV_DIR

[ -n "$TLENV_ORIG_PATH" ] || export TLENV_ORIG_PATH="$PATH"

canonicalize() {
  local readlink resolved_path
  if readlink="$(type -P greadlink)" || readlink="$(type -P readlink)"; then
    # happy path: GNU & BSD readlink, macOS 12.3+
    if resolved_path="$("$readlink" -f "$1" 2>/dev/null)"; then
      printf "%s\n" "$resolved_path"
      return 0
    fi
    # likely macOS < 12.3 with old readlink
    local path="$1"
    while [ -L "$path" ]; do
      resolved_path="$("$readlink" "$path" 2>/dev/null)"
      [[ $resolved_path == /* ]] || resolved_path="$(cd "${path%/*}/${resolved_path%/*}" && pwd)/${resolved_path##*/}"
      path="$resolved_path"
    done
    printf "%s\n" "$path"
    return 0
  fi
  # fail if the argument is a symlink and was not canonicalized
  [ ! -L "$1" ] || return 1
}

shopt -s nullglob

# all this trouble just to find out where tlenv's executables live
tlenv_bin="${BASH_SOURCE:-$0}"
if libexec_dir="$(canonicalize "$tlenv_bin")"; then
  libexec_dir="${libexec_dir%/*}"
else
  libexec_dir="${tlenv_bin%/*}"
  [ "$libexec_dir" != "." ] || libexec_dir="$PWD"
fi

for plugin_bin in "${TLENV_ROOT}/plugins/"*/bin; do
  PATH="${plugin_bin}:${PATH}"
done
export PATH="${libexec_dir}:${PATH}"

TLENV_HOOK_PATH="${TLENV_HOOK_PATH}:${TLENV_ROOT}/tlenv.d"
if [ ! "${libexec_dir%/*}"/tlenv.d -ef "$TLENV_ROOT"/tlenv.d ]; then
  # Add tlenv's own `tlenv.d` unless tlenv was cloned to TLENV_ROOT
  TLENV_HOOK_PATH="${TLENV_HOOK_PATH}:${libexec_dir%/*}/tlenv.d"
fi
TLENV_HOOK_PATH="${TLENV_HOOK_PATH}:/usr/etc/tlenv.d:/usr/local/etc/tlenv.d:/etc/tlenv.d:/usr/lib/tlenv/hooks"
for plugin_hook in "${TLENV_ROOT}/plugins/"*/etc/tlenv.d; do
  TLENV_HOOK_PATH="${TLENV_HOOK_PATH}:${plugin_hook}"
done
TLENV_HOOK_PATH="${TLENV_HOOK_PATH#:}"
export TLENV_HOOK_PATH

shopt -u nullglob


command="$1"
case "$command" in
"" )
  { tlenv---version
    tlenv-help
  } | abort
  ;;
-v | --version )
  exec tlenv---version
  ;;
-h | --help )
  exec tlenv-help
  ;;
* )
  command_path="$(type -P "tlenv-$command" || true)"
  if [ -z "$command_path" ]; then
    if [ "$command" == "shell" ]; then
      abort "shell integration not enabled. Run \`tlenv init' for instructions."
    else
      abort "no such command \`$command'"
    fi
  fi

  shift 1
  if [ "$1" = --help ]; then
    if [[ "$command" == "sh-"* ]]; then
      echo "tlenv help \"$command\""
    else
      exec tlenv-help "$command"
    fi
  else
    exec "$command_path" "$@"
  fi
  ;;
esac
