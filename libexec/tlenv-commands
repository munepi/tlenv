#!/usr/bin/env bash
# Summary: List all available tlenv commands
# Usage: tlenv commands [--sh|--no-sh]
#
# List names of all tlenv commands, including 3rd-party ones found in the
# PATH or in tlenv plugins. With `--sh`, list only shell commands.
#
# This functionality is mainly meant for scripting. To see usage help for
# tlenv, run `tlenv help`.

set -e
[ -n "$TLENV_DEBUG" ] && set -x

# Provide tlenv completions
if [ "$1" = "--complete" ]; then
  echo --sh
  echo --no-sh
  exit
fi

exclude_shell=
command_prefix="tlenv-"

if [ "$1" = "--sh" ]; then
  command_prefix="tlenv-sh-"
  shift
elif [ "$1" = "--no-sh" ]; then
  exclude_shell=1
  shift
fi

shopt -s nullglob

{
  PATH_remain="$PATH"
  # traverse PATH to find "tlenv-" prefixed commands
  while true; do
    path="${PATH_remain%%:*}"
    if [ -n "$path" ]; then
      for tlenv_command in "${path}/${command_prefix}"*; do
        tlenv_command="${tlenv_command##*tlenv-}"
        if [[ -z $exclude_shell || $tlenv_command != sh-* ]]; then
          echo "${tlenv_command##sh-}"
        fi
      done
    fi
    [[ $PATH_remain == *:* ]] || break
    PATH_remain="${PATH_remain#*:}"
  done
} | sort | uniq
